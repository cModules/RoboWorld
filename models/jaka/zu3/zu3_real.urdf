<?xml version="1.0" encoding="utf-8"?>
<robot name="jaka_zu3_real">
  <!-- JAKA zu3 — 真机 CAD（厂商官网 STEP，build_vendor_urdf.py 生成）。几何为真实外形，运动学（轴/限位）复用程序化 URDF。 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes_real/base_link.stl"/></geometry>
      <material name="base_link_m"><color rgba="0.80 0.82 0.85 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes_real/base_link.stl"/></geometry>
    </collision>
  </link>
