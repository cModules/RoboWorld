    <origin xyz="0.0449633 0.00696811 -0.08605" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28318" upper="6.28318" effort="58" velocity="3.14159"/>
  </joint>
